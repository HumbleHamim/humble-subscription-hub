rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is any account that has a document at admins/{uid}.
    // Those documents can only be created from the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Anyone can read the catalog; only admins can change it.
    match /products/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders and content rules are added in their own steps.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
